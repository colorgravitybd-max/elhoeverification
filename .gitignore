# Environment files (NEVER commit)
config/.env
.env
.env.local
.env.*.local

# Storage runtime data
storage/logs/*
storage/cache/*
storage/uploads/*
storage/exports/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/uploads/.gitkeep
!storage/exports/.gitkeep

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Backups & logs
*.bak
*.sql.bak
*.log
error_log

# Composer (we don't use it, but block in case)
/vendor/
composer.lock
