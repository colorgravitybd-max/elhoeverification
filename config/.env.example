# ============================================================================
# ELHOE Verification System - Environment Configuration
# Copy this file to config/.env and fill in your values.
# NEVER commit config/.env to version control.
# ============================================================================

# --- Application ---
APP_NAME="ELHOE Product Verification"
APP_URL="https://www.elhoe.com/checker"
APP_ENV="production"          # production | development
APP_DEBUG="false"             # true | false  (NEVER true in production)
APP_TIMEZONE="Asia/Dhaka"

# --- Database (Hostinger MySQL) ---
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_elhoe_chk"
DB_USER="u123456789_elhoeadm"
DB_PASS="CHANGE_THIS_TO_YOUR_DB_PASSWORD"
DB_CHARSET="utf8mb4"

# --- Sessions ---
SESSION_NAME="elhoe_admin_sess"
SESSION_LIFETIME_MINUTES="120"
COOKIE_SECURE="true"          # true on HTTPS sites
COOKIE_SAMESITE="Lax"

# --- Security ---
APP_KEY="CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING"   # used for hashing, CSRF
ADMIN_LOGIN_ATTEMPTS="5"
ADMIN_LOGIN_LOCKOUT_MINUTES="15"

# --- Rate limiting (per IP) ---
RATE_LIMIT_VERIFY_PER_MIN="10"
RATE_LIMIT_REGISTER_PER_HOUR="5"

# --- GeoIP (free HTTPS API, no key) ---
GEOIP_PROVIDER="ipwho.is"     # primary
GEOIP_FALLBACK="ipapi.co"     # fallback
GEOIP_CACHE_DAYS="30"

# --- Brand defaults (overridable in admin Settings) ---
BRAND_NAME="ELHOE"
BRAND_TAGLINE="Redefine Your Skincare Journey"
BRAND_SUPPORT_EMAIL="support@elhoe.com"
BRAND_SUPPORT_WHATSAPP=""

# --- Marketing integrations (set in admin Settings, here as fallback) ---
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_CAPI_TEST_CODE=""
GTM_CONTAINER_ID=""

# --- Admin email alerts ---
ADMIN_ALERT_EMAIL=""          # leave empty to disable
ADMIN_ALERT_FROM="no-reply@elhoe.com"

# --- Logging ---
LOG_LEVEL="info"              # debug | info | warning | error
LOG_RETENTION_DAYS="30"
